# Public site URL used for metadata, sitemap and robots (no trailing slash)
SITE_URL=https://your-domain.com
# Supabase (newsletter subscribers). If unset, emails go to data/subscribers.json (local dev only).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # server-only secret; never prefix with NEXT_PUBLIC_
